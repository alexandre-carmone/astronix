#!/usr/bin/env bash
# INA GlobalProtect VPN: Keycloak SAML + inWebo/TrustBuilder OTP -> openconnect.
# Password and the inWebo PIN come from the keyring; the OTP is generated by tb-otp.
# INA_OTP_CMD=<cmd> overrides the generator; INA_OTP_CMD=- forces typing it by hand.
set -euo pipefail

SERVER=${INA_SERVER:-connexion.ina.fr}
# Gateway prelogin: the portal one (global-protect/prelogin.esp) only yields a
# web-portal session, no client cookie.
PRELOGIN=${INA_PRELOGIN:-ssl-vpn/prelogin.esp}
# Per-user settings. The INA username stays out of this script, so you can share it.
# Example ~/.config/ina-vpn.env:   INA_LOGIN=jdupont
CONF=${INA_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/ina-vpn.env}
# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"
LOGIN=${INA_LOGIN:?no INA username. Set INA_LOGIN, or write INA_LOGIN=<user> into $CONF}
INWEBO_LOGIN=${INA_INWEBO_LOGIN:-$LOGIN}
SECRET_LOOKUP=${INA_SECRET_LOOKUP:-ldap password}
# inWebo OTP generator. tb-otp drives inWebo's own library headlessly and takes its
# PIN from the keyring, so this needs no input. Empty array => type the code.
OTP_ARGV=()
if [ "${INA_OTP_CMD:-}" = "-" ]; then
  :
elif [ -n "${INA_OTP_CMD:-}" ]; then
  read -ra OTP_ARGV <<<"$INA_OTP_CMD"
elif command -v tb-otp >/dev/null 2>&1; then
  OTP_ARGV=(tb-otp otp)
elif [ -x "$HOME/tb-otp/src/cli.js" ]; then
  OTP_ARGV=("$HOME/tb-otp/src/cli.js" otp)
fi
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120 Safari/537.36'

d=$(mktemp -d)
chmod 700 "$d"
trap '[ -n "${INA_DEBUG:-}" ] || rm -rf "$d"' EXIT
if [ -n "${INA_DEBUG:-}" ]; then echo "ina-vpn: debug files kept in $d"; fi
page=$d/page
jar=$d/jar
hdr=$d/hdr
eff=$d/eff

die() {
  echo "ina-vpn: $*" >&2
  exit 1
}
step() { printf '\033[36m==>\033[0m %s\n' "$*"; }

secret() {
  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup $SECRET_LOOKUP
  else nix shell nixpkgs#libsecret -c secret-tool lookup $SECRET_LOOKUP; fi
}

# Generate or ask for a code. The final attempt is always typed, so a tb-otp problem
# (desynced ratchet, wrong PIN, missing state) can never lock you out of the VPN.
otp_get() {
  local try=$1 code=
  if [ ${#OTP_ARGV[@]} -gt 0 ] && [ "$try" != 3 ]; then
    if code=$("${OTP_ARGV[@]}" 2>/dev/null) && [ -n "$code" ]; then
      echo "  code from ${OTP_ARGV[0]##*/}" >&2
      printf '%s' "$code"
      return
    fi
    echo "  ${OTP_ARGV[0]##*/} produced no code, type one instead" >&2
  fi
  read -rp "  OTP code: " code </dev/tty
  printf '%s' "$code"
}

req() { curl -sS -b "$jar" -c "$jar" -A "$UA" -o "$page" -D "$hdr" -w '%{url_effective}' "$@" >"$eff"; }
gpreq() { curl -sS -b "SESSID=$sessid" -A 'PAN GlobalProtect' -o "$page" -D "$hdr" -w '%{url_effective}' "$@" >"$eff"; }
# HTML tags here span multiple lines, so flatten before matching.
flat() { tr '\n' ' ' <"$page"; }
unesc() { sed -e 's/&amp;/\&/g' -e 's/&quot;/"/g' -e "s/&#39;/'/g"; }
form_action() { flat | grep -oP "<form[^>]*${1:-}[^>]*action=\"\K[^\"]*" | head -1 | unesc || true; }
input_val() { flat | grep -oP "<input[^>]*name=\"$1\"[^>]*value=\"\K[^\"]*" | head -1 | unesc || true; }
kc_error() { flat | grep -oP 'kc-feedback-text[^>]*>\K[^<]*' | unesc | tr -s ' ' || true; }
hget() { grep -oiP "^$1:[ \t]*\K[^\r]+" "$hdr" | tail -1 || true; }
abs() {
  case $1 in
  http*) printf '%s' "$1" ;;
  /*) printf '%s%s' "$(grep -oP '^https?://[^/]+' "$eff")" "$1" ;;
  *) printf '%s' "$1" ;;
  esac
}

step "GlobalProtect prelogin"
curl -sS -A 'PAN GlobalProtect' -X POST "https://$SERVER/$PRELOGIN" \
  --data 'tmp=tmp&clientVer=4100&clientos=Linux' -D "$d/pre.hdr" -o "$d/pre.xml" ||
  die "prelogin failed"
# PAN ties the prelogin-cookie to this SESSID, and curl never persists session
# cookies to the jar, so carry it by hand on every gateway request.
sessid=$(grep -oiP '^set-cookie:[ \t]*SESSID=\K[^;]+' "$d/pre.hdr" || true)
saml=$(grep -oP '(?<=<saml-request>)[^<]+' "$d/pre.xml" | base64 -d)
[ -n "$saml" ] || die "no SAML request in prelogin response"

step "Keycloak login as $LOGIN"
req -L "$saml"
action=$(form_action 'id="kc-form-login"')
[ -n "$action" ] || die "no Keycloak login form (INA_DEBUG=1 keeps $d)"

secret | tr -d '\n' >"$d/pw"
[ -s "$d/pw" ] || die "empty keyring secret: secret-tool lookup $SECRET_LOOKUP"
req -L "$action" --data-urlencode "username=$LOGIN" --data-urlencode "password@$d/pw" \
  --data-urlencode 'credentialId='
rm -f "$d/pw"
if flat | grep -q 'name="password"'; then die "login rejected:$(kc_error)"; fi

step "inWebo 2FA"
action=$(abs "$(form_action 'id="mobileForm"')")
[ -n "$action" ] || die "unexpected 2FA page (INA_DEBUG=1 keeps $d)"
for try in 1 2 3; do
  returnto=$(input_val ReturnTo)
  otp=$(otp_get "$try")
  req -L "$action" --data-urlencode "LOGIN=$INWEBO_LOGIN" --data-urlencode "OTP=$otp" \
    --data-urlencode "ReturnTo=$returnto"
  if ! flat | grep -q 'name="OTP"'; then break; fi
  [ "$try" = 3 ] && die "OTP rejected 3 times"
  echo "  rejected, try again"
  action=$(abs "$(form_action 'id="mobileForm"')")
done

step "relaying SAML assertion"
for _ in 1 2 3 4 5; do
  flat | grep -q 'name="SAMLResponse"' || break
  args=(--data-urlencode "SAMLResponse=$(input_val SAMLResponse)")
  relay=$(input_val RelayState)
  [ -n "$relay" ] && args+=(--data-urlencode "RelayState=$relay")
  target=$(abs "$(form_action)")
  # The ACS must see our PAN session, and its redirect must not be followed.
  case $target in
  *"$SERVER"*) gpreq "$target" "${args[@]}" ;;
  *) req -L "$target" "${args[@]}" ;;
  esac
done

gpuser=$(hget saml-username)
pre=$(hget prelogin-cookie)
[ -n "$pre" ] || die "ACS returned no prelogin-cookie (files in $d)"

step "gateway login as $gpuser"
# openconnect sends no passwd field at all when given a destination form field,
# and PAN rejects that with auth-failed-password-empty, so do this leg here.
gpreq "https://$SERVER/ssl-vpn/login.esp" \
  --data 'prot=https:' --data 'inputStr=' --data 'jnlpReady=jnlpReady' \
  --data 'ok=Login' --data 'direct=yes' --data 'clientVer=4100' \
  --data 'clientos=Linux' --data 'os-version=linux-64' --data 'ipv6-support=yes' \
  --data-urlencode "server=$SERVER" --data-urlencode "computer=$(hostname)" \
  --data-urlencode "user=$gpuser" --data 'passwd=' \
  --data-urlencode "prelogin-cookie=$pre"
cp "$page" "$d/login.xml"

# login.esp answers with a JNLP whose <argument> list is positional:
# 1=authcookie, 3=portal, 4=user, 7=domain. Match empties too, or indices shift.
mapfile -t arg < <(tr '\n' ' ' <"$page" |
  grep -oP '<argument>[^<]*</argument>' | sed -e 's|^<argument>||' -e 's|</argument>$||')
authcookie=${arg[1]:-}
portal=${arg[3]:-}
gpuser=${arg[4]:-$gpuser}
domain=${arg[7]:-}
if [ -z "$authcookie" ] || [ -z "$portal" ]; then
  sed 's/<[^>]*>/ /g' "$page" | tr -s ' \n' ' \n' | head -3 >&2
  die "login.esp gave no authcookie/portal (response above, files in $d)"
fi

step "connecting to $portal as $gpuser"
oc=$(readlink -f "$(command -v openconnect)") || die "openconnect not found"
hip=${oc%/bin/openconnect}/libexec/openconnect/hipreport.sh
ocargs=(--protocol=gp --user "$gpuser" --cookie-on-stdin)
[ -x "$hip" ] && ocargs+=(--csd-wrapper "$hip")
# getconfig.esp answers "errors getting SSL/VPN config" without portal.
cookie="authcookie=$authcookie&portal=$portal&user=$gpuser&domain=$domain&computer=$(hostname)"

sudo -v
if [ -n "${INA_DEBUG:-}" ]; then
  ocargs+=(--dump-http-traffic)
  printf '%s\n' "$cookie" | sudo "$oc" "${ocargs[@]}" "$@" "$SERVER" 2>&1 | tee "$d/openconnect.log"
else
  printf '%s\n' "$cookie" | sudo "$oc" "${ocargs[@]}" "$@" "$SERVER"
fi
